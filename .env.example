# ==============================================================================
# Copernicus Data Space Ecosystem (CDSE) API Credentials
# ==============================================================================
# Instructions:
# 1. Register for a free account at: https://dataspace.copernicus.eu
# 2. Go to the Sentinel Hub user dashboard to generate OAuth API Client credentials:
#    https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
# 3. Copy this file to .env and fill in your Client ID and Client Secret:
#    cp .env.example .env
#
# IMPORTANT: NEVER commit your actual .env file with secrets to public GitHub!
# ==============================================================================

SH_PROVIDER=cdse
SH_CLIENT_ID=your_cdse_client_id_here
SH_CLIENT_SECRET=your_cdse_client_secret_here

# Optional: Custom input and output directories (defaults to input/ and output/)
# INPUT_DIR=input
# OUTPUT_DIR=output
